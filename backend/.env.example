# Copy this file to ".env" and fill in your own values.
# Atlas: Database -> Connect -> Drivers -> copy the connection string, then
# replace <password> and add the database name (/obscura) before the "?".
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/obscura?retryWrites=true&w=majority
DB_NAME=obscura
JWT_SECRET=change-this-to-any-long-random-string
PORT=5000
